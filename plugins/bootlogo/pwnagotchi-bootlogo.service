[Unit]
Description=Pwnagotchi boot logo
DefaultDependencies=no
After=local-fs.target
Before=pwnagotchi.service

[Service]
Type=oneshot
# жёсткий таймаут: показ лого не должен держать загрузку pwnagotchi
TimeoutStartSec=30
ExecStart=/usr/bin/timeout 20 /usr/bin/python3 /usr/local/bin/pwnagotchi-bootlogo.py
RemainAfterExit=no
SuccessExitStatus=0 124

[Install]
WantedBy=multi-user.target
